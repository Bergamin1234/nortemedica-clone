# =========================================================================
# CONFIGURAÇÃO APACHE / HOSTGATOR (ALLIGATOR) cPanel
# Norte Médica - E-Commerce Pronto para Produção
# =========================================================================

# Impede listagem de diretórios
Options -Indexes

# Define index padrão
DirectoryIndex index.php index.html

# Forçar UTF-8
AddDefaultCharset UTF-8

# Ativar RewriteEngine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Evita que pastas ou arquivos reais sejam reescritos
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rotas amigáveis simples
    RewriteRule ^produto/([a-zA-Z0-9_-]+)/?$ produto.php?slug=$1 [L,QSA]
    RewriteRule ^categoria/([a-zA-Z0-9_-]+)/?$ index.php?categoria=$1 [L,QSA]
    RewriteRule ^carrinho/?$ carrinho.php [L,QSA]
    RewriteRule ^checkout/?$ checkout.php [L,QSA]
    RewriteRule ^pedido-sucesso/([a-zA-Z0-9_-]+)/?$ pedido-sucesso.php?codigo=$1 [L,QSA]
    RewriteRule ^quem-somos/?$ sobre.php [L,QSA]
    RewriteRule ^contato/?$ contato.php [L,QSA]
</IfModule>

# Compressão GZIP para máxima performance no HostGator
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# Cabeçalhos de Segurança
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Proteção de arquivos sensíveis
<FilesMatch "(config\.php|database\.sql|\.sqlite|\.env)$">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
